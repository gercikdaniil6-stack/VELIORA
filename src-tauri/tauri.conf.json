{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VELIORA App",
  "mainBinaryName": "VELIORA",
  "version": "2.2.11",
  "identifier": "app.veliora.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1428",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "VELIORA App",
        "width": 1180,
        "height": 780,
        "minWidth": 960,
        "minHeight": 620,
        "center": true,
        "decorations": false,
        "resizable": true,
        "backgroundColor": "#101521",
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "VELIORA",
    "copyright": "© 2026 VELIORA",
    "category": "Utility",
    "shortDescription": "VELIORA App — Telegram-прокси, обход DPI и системный прокси",
    "longDescription": "VELIORA App объединяет локальный Telegram WS-прокси, обход DPI на базе Zapret с подбором стратегий и редактором списков, а также профили системного прокси Windows.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "installMode": "perMachine",
        "languages": [
          "Russian",
          "English"
        ],
        "displayLanguageSelector": false
      }
    },
    "resources": {
      "installer/vc-runtime/": "tdlib/",
      "components/": "components/",
      "../node_modules/@prebuilt-tdlib/win32-x64/tdjson.dll": "tdlib/tdjson.dll",
      "../node_modules/@prebuilt-tdlib/win32-x64/LICENSE": "tdlib/LICENSE-package.txt",
      "licenses/TDLib.txt": "tdlib/LICENSE-TDLib.txt"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDBFQkNGRjgxMjgxMDcwNTgKUldSWWNCQW9nZis4RG9lN2NyTmlzekp6ZlJVQitnM2ZDaVo0bWI2Y083QXdnQTBwWkVqZTFqNXAK",
      "endpoints": [
        "https://github.com/gercikdaniil6-stack/VELIORA/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      },
      "requireSignedVersion": true
    }
  }
}
